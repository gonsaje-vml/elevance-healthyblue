{
  "org": "gonsaje-vml",
  "site": "elevance-healthyblue",
  "branch": "main",
  "outputs": {
    "preview": "asset-index-preview.json",
    "live": "asset-index.json"
  },
  "roots": [
    "/docs"
  ],
  "extensions": [
    "pdf",
    "doc",
    "docx",
    "xls",
    "xlsx",
    "ppt",
    "pptx",
    "csv",
    "rtf",
    "txt"
  ],
  "minimumFiles": 1,
  "maxFiles": 1000,
  "pdfMaxPages": 0,
  "contentMaxCharacters": 250000,
  "concurrency": 2,
  "allowPartial": false
}
